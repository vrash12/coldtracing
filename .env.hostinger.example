APP_NAME=ColdTrace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://coldtrace.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_HOSTINGER_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_DATABASE_USERNAME
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@coldtrace.online
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# Broker the ESP32 fleet publishes to. `php artisan coldtrace:mqtt-listen`
# connects here and writes every reading into the database.
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_TLS=true
HIVEMQ_VERIFY_PEER=true
HIVEMQ_CA_FILE=
HIVEMQ_CLIENT_ID=coldtrace-laravel-bridge
HIVEMQ_KEEP_ALIVE=60
HIVEMQ_QOS=1

# Websocket URL used by the driver's browser for the live map only.
HIVEMQ_WEBSOCKET_URL=REPLACE_WITH_HIVEMQ_WSS_URL
HIVEMQ_USERNAME=REPLACE_WITH_HIVEMQ_USERNAME
HIVEMQ_PASSWORD=REPLACE_WITH_HIVEMQ_PASSWORD
HIVEMQ_TELEMETRY_TOPIC=coldtrace/trucks/+/telemetry
COLDTRACE_TELEMETRY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_DEVICE_TOKEN

COLDTRACE_DEVICE_1001_TRUCK_ID=
COLDTRACE_DEVICE_1002_TRUCK_ID=
COLDTRACE_DEVICE_1003_TRUCK_ID=
COLDTRACE_DEVICE_1004_TRUCK_ID=
COLDTRACE_DEVICE_1005_TRUCK_ID=
COLDTRACE_DEVICE_1006_TRUCK_ID=

COLDTRACE_INITIAL_ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
COLDTRACE_INITIAL_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
COLDTRACE_INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD

VITE_APP_NAME="${APP_NAME}"
