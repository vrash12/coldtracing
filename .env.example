APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Broker the ESP32 fleet publishes to. `php artisan coldtrace:mqtt-listen`
# connects here and writes every reading into the database.
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_TLS=true
HIVEMQ_VERIFY_PEER=true
HIVEMQ_CA_FILE=
HIVEMQ_CLIENT_ID=coldtrace-laravel-bridge
HIVEMQ_KEEP_ALIVE=60
HIVEMQ_QOS=1

# Websocket URL used by the driver's browser for the live map only.
HIVEMQ_WEBSOCKET_URL=
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
HIVEMQ_TELEMETRY_TOPIC=coldtrace/trucks/+/telemetry

# Shared device credential required by POST /api/telemetry when configured.
# Use the same value in each generated ColdTrace ESP32 sketch.
COLDTRACE_TELEMETRY_TOKEN=

# Optional database truck assignments for the six ESP32 devices.
# Leave blank until the corresponding truck row exists.
COLDTRACE_DEVICE_1001_TRUCK_ID=
COLDTRACE_DEVICE_1002_TRUCK_ID=
COLDTRACE_DEVICE_1003_TRUCK_ID=
COLDTRACE_DEVICE_1004_TRUCK_ID=
COLDTRACE_DEVICE_1005_TRUCK_ID=
COLDTRACE_DEVICE_1006_TRUCK_ID=

# Used only to provision the first production administrator.
# Remove the password value after running the production seeder.
COLDTRACE_INITIAL_ADMIN_NAME=
COLDTRACE_INITIAL_ADMIN_EMAIL=
COLDTRACE_INITIAL_ADMIN_PASSWORD=

GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=coldtrace
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
